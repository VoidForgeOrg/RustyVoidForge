# The build context for dockerfiles/Dockerfile: the workspace's sources only, so a change to a script,
# a document or the compose files never invalidates the build's layers. target/ alone would be
# gigabytes.
target/
**/target/
.git/
.github/
deploy/
dockerfiles/
!dockerfiles/static-web-server.toml
docs/
tests/
# The web app is built inside the image, from its lock file.
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
# Local agent and editor state: never in a build layer (R1-3).
.mcp.json
.claude/
.codex/
.agents/
.openrig/
.env
*.md
!crates/**/*.md
